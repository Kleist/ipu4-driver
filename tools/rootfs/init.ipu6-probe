#!/bin/sh
# Guest init for the ipu6 ladder's probe tests (probe-identify onwards,
# tools/tests/ipu6/ladder.sh): load the modules as init.ipu6-modules
# does (intel-ipu6 probes the IPU4 inside its insmod, through the PCI ID
# the last patch of the series adds), report how far probe got, unbind,
# unload and scan dmesg.
#
# This file is only the frame. Each probe test's guest-side checks are
# their own snippet in init.ipu6-probe.d/ (packed as /init.d/ by
# tools/rootfs/build.sh; README.md there): *.bound.sh run while the
# driver is bound, *.unloaded.sh after unbind and rmmod, each in name
# order.
#
# Markers of the frame, parsed by the ladder on the host:
#   PROBE:ok|fail <what>     module load/unload; any PROBE:fail fails
#                            every probe test
#   PROBE:info <what>        how far probe got (not a check)
#   PROBE:bound yes|no       whether intel-ipu6 was bound (informational)
#   PROBE:oops none|found    kernel log free of oops/BUG/WARNING
#   PROBE: DONE              the init ran to the end
# A snippet's own markers (PROBE:identify ok|fail, ...) are not
# "PROBE:fail", so each test checks its own.

PATH=/bin:/sbin
export PATH

mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev 2>/dev/null || true

# The driver's module, device and node names (IPU_*): staged by
# tools/rootfs/build.sh from tools/rootfs/ipu-driver.<flavor>.conf.
. /etc/ipu-driver.conf
# Unload order: the driver's modules in reverse, then the sensor.
rmmods=
for m in $IPU_SENSOR_MODULE $IPU_MODULES; do
	rmmods="$(echo "$m" | sed 's/-/_/g') $rmmods"
done

say() {
	echo "PROBE:$*"
}

# The IPU's PCI ID: the QEMU model variant's, which tools/run-vm.sh may
# pass as ipu_pci_id= (8086:5a88, IPU4, when absent). Read before the
# module loads, since virt-sensor attaches its graph to that device.
want=0x5a88
read -r cmdline < /proc/cmdline
for arg in $cmdline; do
	case "$arg" in
	ipu_pci_id=*) want=${arg#ipu_pci_id=} ;;
	esac
done

# busybox insmod does not apply <module>.dyndbg= from the kernel command
# line (run-vm.sh), so pass it here. The firmware loader's debug output
# names the file it loads, which the identify check below relies on once
# the firmware exists.
echo 'file drivers/base/firmware_loader/main.c +p' \
	> /proc/dynamic_debug/control 2>/dev/null ||
	say "fail firmware loader dyndbg"

for m in videobuf2-common videobuf2-memops videobuf2-v4l2 videobuf2-dma-sg \
	$IPU_SENSOR_MODULE $IPU_MODULES; do
	# The MMU code logs every page it maps at debug level; mapping the
	# 8 MB trash buffer alone pushes the start of probe out of the
	# kernel log buffer. Keep ipu6-mmu.c quiet, except the line that
	# says the MMU hardware init got as far as the trash buffer. This
	# has to be part of the insmod: probe may run inside it.
	case "$m" in
	videobuf2-*) args= ;;
	"$IPU_PCI_DRIVER") args='dyndbg="+p;file ipu6-mmu.c -p;format iova\040trash\040buffer +p"' ;;
	virt-sensor) args="dyndbg=+p device=$want" ;;
	*) args=dyndbg=+p ;;
	esac
	# shellcheck disable=SC2086 # $args is empty or one word
	if insmod "/lib/modules/$m.ko" $args; then
		say "ok insmod $m"
	else
		say "fail insmod $m"
	fi
done

ipu=
for dev in /sys/bus/pci/devices/*; do
	if [ "$(cat "$dev/vendor")" = 0x8086 ] &&
	   [ "$(cat "$dev/device")" = "$want" ]; then
		ipu=${dev##*/}
	fi
done
[ -n "$ipu" ] || say "fail no 8086:$want PCI device"

echo "=== dmesg ($IPU_PCI_DRIVER $ipu) ==="
dmesg | grep -E "$ipu|$IPU_MODNAME|$IPU_PCI_DRIVER"
echo "=== end dmesg ==="

# The probe tests' checks while the driver is bound.
for s in /init.d/*.bound.sh; do
	[ -e "$s" ] || continue
	# shellcheck source=/dev/null
	. "$s"
done

# How far probe got, for the later probe-* tests.
if dmesg | grep -F "$ipu" | grep -q 'hardware version'; then
	say "info pci probe done"
fi
n=0
for v in /dev/video*; do
	[ -e "$v" ] && n=$((n + 1))
done
say "info $n video nodes"

if [ -e "/sys/bus/pci/devices/$ipu/driver" ]; then
	say "bound yes"
	echo "$ipu" > "/sys/bus/pci/drivers/$IPU_PCI_DRIVER/unbind"
else
	say "bound no"
fi

lsmod

for m in $rmmods; do
	if rmmod "$m"; then
		say "ok rmmod $m"
	else
		say "fail rmmod $m"
	fi
done

# The probe tests' checks after unbind and rmmod.
for s in /init.d/*.unloaded.sh; do
	[ -e "$s" ] || continue
	# shellcheck source=/dev/null
	. "$s"
done

if dmesg | grep -E 'Oops|BUG:|WARNING:|Call Trace'; then
	say "oops found"
else
	say "oops none"
fi

echo "PROBE: DONE"
poweroff -f
