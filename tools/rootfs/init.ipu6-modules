#!/bin/sh
# Guest init for the ipu6 ladder's module-load test
# (tools/tests/ipu6/ladder.sh): load the virtual sensor and the upstream
# ipu6 modules in dependency order, check the IPU PCI device, unload
# everything again and scan dmesg for oopses/warnings.
#
# Whether intel-ipu6 binds to the IPU (and how far probe gets) is
# reported but not checked here; the probe-* tests check that. The PCI ID
# to look for is the QEMU model variant's: tools/run-vm.sh passes it as
# ipu_pci_id= (8086:5a88, IPU4, when absent).
#
# The MODLOAD: markers are parsed by the ladder on the host.
#
# Later tests that need the driver loaded but no register-write capture
# add their guest-side checks as init.ipu6-modules.d/NNN-<test>.loaded.sh
# (packed as /init.d/), run in name order before the unload; they print
# their own MODLOAD:<test> markers and see $ipu (the IPU's sysfs path).

PATH=/bin:/sbin
export PATH

mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev 2>/dev/null || true

# The driver's module, device and node names (IPU_*): staged by
# tools/rootfs/build.sh from tools/rootfs/ipu-driver.<flavor>.conf.
. /etc/ipu-driver.conf
# Unload order: the driver's modules in reverse, then the sensor.
rmmods=
for m in $IPU_SENSOR_MODULE $IPU_MODULES; do
	rmmods="$(echo "$m" | sed 's/-/_/g') $rmmods"
done

fail=0

want=0x5a88
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	ipu_pci_id=*) want=${arg#ipu_pci_id=} ;;
	esac
done

say() {
	echo "MODLOAD:$*"
}

# Dependency order: vb2 helpers, the sensor (its fwnode graph must exist
# before the IPU driver probes), then the IPU core and ISYS.
for m in videobuf2-common videobuf2-memops videobuf2-v4l2 videobuf2-dma-sg \
	$IPU_SENSOR_MODULE $IPU_MODULES; do
	args=
	[ "$m" = virt-sensor ] && args="device=$want"
	insmod "/lib/modules/$m.ko" $args
	rc=$?
	if [ "$rc" -eq 0 ]; then
		say "ok $m"
	else
		say "fail $m rc=$rc"
		fail=1
	fi
done

ipu=
for dev in /sys/bus/pci/devices/*; do
	if [ "$(cat "$dev/vendor")" = 0x8086 ] &&
	   [ "$(cat "$dev/device")" = "$want" ]; then
		ipu=$dev
	fi
done

if [ -z "$ipu" ]; then
	say "fail no 8086:$want PCI device"
	fail=1
elif [ -e "$ipu/driver" ]; then
	drv=$(cd "$ipu/driver" && pwd -P)
	say "info ${ipu##*/} bound to ${drv##*/}"
else
	say "info ${ipu##*/} unbound"
fi

if [ -z "$IPU_SENSOR_MODULE" ]; then
	say "info sensor built into the driver"
elif [ -d /sys/bus/platform/devices/ipu4-virt-sensor ]; then
	say "ok virt-sensor device"
else
	say "fail no ipu4-virt-sensor platform device"
	fail=1
fi

lsmod

for s in /init.d/*.loaded.sh; do
	[ -e "$s" ] || continue
	# shellcheck source=/dev/null
	. "$s"
done

# Clean unload, reverse order.
for m in $rmmods; do
	rmmod "$m"
	rc=$?
	if [ "$rc" -eq 0 ]; then
		say "ok rmmod $m"
	else
		say "fail rmmod $m rc=$rc"
		fail=1
	fi
done

if dmesg | grep -E 'Oops|BUG:|WARNING:|Call Trace'; then
	say "fail kernel log has oops/warning (above)"
	fail=1
fi

if [ "$fail" -eq 0 ]; then
	echo "MODLOAD: PASS"
else
	echo "MODLOAD: FAIL"
fi

gcov-harvest ipu6-modules

poweroff -f
