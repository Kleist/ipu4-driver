#!/bin/sh
# M3 init: load intel-ipu4.ko, let it probe against the emulated IPU4
# device, dump everything interesting to the serial console. The smoke
# test on the host greps for the PROBE_OK: markers below.

PATH=/bin:/sbin
export PATH

mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
mount -t devtmpfs none /dev 2>/dev/null || true

# Optional 9p share for log drop / gcov harvest.
mount -t 9p -o trans=virtio tests /mnt/tests 2>/dev/null || true

# Enable dynamic-debug for the whole driver module before insmod. The
# module's dyndbg= param is honoured at module-init time.
echo 0 > /proc/sys/kernel/printk_devkmsg 2>/dev/null || true

for m in v4l2-async \
	videobuf2-common videobuf2-memops videobuf2-v4l2 videobuf2-dma-sg \
	ambu-ipu-bridge intel-ipu4; do
	ko=/lib/modules/$m.ko
	[ -f "$ko" ] || continue
	insmod "$ko" dyndbg=+p 2>&1 || true
done

# intel-ipu4-isys depends on symbols from intel-ipu4. If intel-ipu4's
# probe oopsed partway through, insmod-ing isys blocks for 30 s each
# on "gave up waiting for init of module" — skip it when the core
# module didn't initialise cleanly. `lsmod` / /proc/modules shows
# "Live" when init completed; anything else (Loading/Unloading) means
# we should not chain further modules on top.
if grep -q '^intel_ipu4 .* Live' /proc/modules 2>/dev/null; then
	insmod /lib/modules/intel-ipu4-isys.ko dyndbg=+p 2>&1 || true
fi

echo
echo "=== /sys/bus/pci/devices ==="
for dev in /sys/bus/pci/devices/*; do
	ven=$(cat "$dev/vendor" 2>/dev/null)
	did=$(cat "$dev/device" 2>/dev/null)
	drv=$(readlink "$dev/driver" 2>/dev/null | sed 's|.*/||')
	echo "$(basename "$dev") $ven:$did driver=${drv:-<none>}"
done

echo
echo "=== dmesg | grep ipu/ipu4/5a88 ==="
dmesg | grep -iE 'ipu|5a88' | tail -80

if [ -d /sys/bus/pci/drivers/intel-ipu4 ]; then
	bound=0
	for dev in /sys/bus/pci/drivers/intel-ipu4/[0-9]*:[0-9]*:[0-9]*.[0-9]*; do
		[ -e "$dev" ] && bound=1
	done
	if [ "$bound" = 1 ]; then
		echo "PROBE_OK: driver bound"
	else
		echo "PROBE_OK: FAIL (driver registered, no device bound)"
	fi
else
	echo "PROBE_OK: FAIL (intel-ipu4 driver not registered)"
fi

for vd in /dev/video*; do
	[ -e "$vd" ] || continue
	echo "PROBE_OK: video=$vd"
done

echo "PROBE_OK: shutting down"
poweroff -f
