CONFIG_KUNIT=y
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_I2C=y
CONFIG_MEDIA_SUPPORT=y
# MEDIA_SUPPORT_FILTER strips prompts from MEDIA_CONTROLLER / VIDEO_DEV
# unless explicitly disabled; without this, olddefconfig drops them.
# CONFIG_MEDIA_SUPPORT_FILTER is not set
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEOBUF2_V4L2=y
# CONFIG_VIDEO_INTEL_IPU6 is not set
CONFIG_VIDEO_INTEL_IPU4=y
CONFIG_VIDEO_INTEL_IPU4_KUNIT_TESTS=y
# Gcov is harvested by tools/tests/kunit.sh's second-boot phase: the
# kunit kernel exposes /sys/kernel/debug/gcov/, init.kunit-cov tars it
# onto the 9p share, and tools/coverage/collect.sh merges the result
# with the streamon-smoke .info before genhtml. The IPU4 driver opts
# in to gcov via `GCOV_PROFILE := y` in its Makefile (see
# tools/linux-patches/.../ipu4/Makefile), so GCOV_KERNEL alone is
# enough — GCOV_PROFILE_ALL would instrument the entire kunit kernel
# (slower build, can break early-boot noinstr code) for no benefit.
CONFIG_DEBUG_FS=y
CONFIG_GCOV_KERNEL=y
