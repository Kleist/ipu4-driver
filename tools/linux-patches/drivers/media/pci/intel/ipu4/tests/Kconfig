config VIDEO_INTEL_IPU4_KUNIT_TESTS
	tristate "KUnit tests for Intel IPU4 driver" if !KUNIT_ALL_TESTS
	depends on KUNIT && VIDEO_INTEL_IPU4
	default KUNIT_ALL_TESTS
	help
	  Small, fast unit tests for pure-logic code paths in the IPU4
	  driver: format-table lookup and Bayer ordering. Expected run
	  time is under one second under qemu-kvm via
	  tools/testing/kunit/kunit.py.
