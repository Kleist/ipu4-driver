<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>IPU4 driver</title>
  <link rel="stylesheet" href="style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
<header class="hero">
  <h1>IPU4 driver</h1>
  <p class="tagline">Intel IPU4 support for Linux, as an out-of-tree module (<code>kernel/ipu4/</code>) and as patches on the upstream ipu6 driver (<code>patches/ipu6-ipu4/</code>), tested against QEMU models of IPU4, IPU4P and IPU6.</p>
  <p class="meta">
    Last updated <time datetime="{{ generated_at }}">{{ generated_at }}</time>
    {% if commit_sha %} · commit <a href="https://github.com/{{ repo }}/commit/{{ commit_sha }}"><code>{{ commit_sha[:7] }}</code></a>{% endif %}
    · <a href="https://github.com/{{ repo }}">repository</a>
  </p>
</header>

<section class="card" id="kernels">
  <h2>Supported kernels</h2>
  <p class="meta">
    <code>kernel/ipu4/</code> builds and passes KUnit on every track in
    <code>.github/kernel-pins/</code>; the ladder runs on <code>v7.3-rc4</code>.
    {% if kernels.run_url %}<a href="{{ kernels.run_url }}">latest ci run on main</a>{% else %}<a href="{{ kernels.workflow_url }}">ci runs</a>{% endif %}
  </p>
  {% if kernels.tracks %}
  <div class="kpi-row">
    {% for k in kernels.tracks %}
    <div class="kpi kernel-track state-{{ k.status or 'unknown' }}">
      <div class="kpi-label">Linux {{ k.name }}</div>
      <div class="kpi-value"><code>{{ k.ref }}</code></div>
      <div class="kpi-sub">build + KUnit: {{ (k.status or 'no data') | replace('_', ' ') }}</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty">No kernel pins found.</p>
  {% endif %}
</section>

<section class="card" id="upstream">
  <h2>Upstream divergence (kernel/ipu4 vs IPU6)</h2>
  {% if upstream.diff %}
  <p>
    Upstream pin: <code>{{ upstream.diff.upstream_pin }}</code> ·
    {{ upstream.diff.files_differ }} files differ ·
    {{ upstream.diff.hunks }} hunks ·
    +{{ upstream.diff.plus }} / −{{ upstream.diff.minus }} lines
  </p>
  {% else %}
  <p class="empty">Diff not regenerated — run <code>tools/upstream/diff.sh</code>.</p>
  {% endif %}
  <h3>Divergence over time</h3>
  {% if upstream.history and upstream.history.points %}
  <p class="meta">
    Lines changed (added + removed) between <code>kernel/ipu4/</code> (and the
    path the driver had before) and upstream <code>{{ upstream.history.upstream_path }}</code>,
    local-only files excluded, after every mainline tag (compared with our tree at its date)
    and every driver commit of ours (compared with the newest tag before it). Markers are
    mainline releases and the steps that moved the count by {{ upstream.history.min_event or 100 }}+
    lines: rcs, and our commits (click one to open it). Before v6.10 upstream has no ipu6
    driver, so every line counts. Commit dates are author dates raised to the latest earlier driver
    commit's date (rebases and cherry-picks keep old author dates).
    {% if upstream.history.master %}Today against upstream master
    ({{ upstream.history.master.date[:10] }}): <strong>{{ upstream.history.master.divergence }}</strong> lines.{% endif %}
  </p>
  <canvas id="upstream-trend" height="90"></canvas>
  {% if upstream.history.target %}
  <h3>Distance to the convergence target</h3>
  <p>
    <strong>{{ upstream.history.target.divergence }}</strong> lines of unexplained divergence
    from the target tree: mainline <code>{{ upstream.history.target.pin[:12] }}</code>
    {% for s, n in upstream.history.target.series.items() %}+ <code>patches/{{ s }}</code> ({{ n }}) {% endfor %}
    — outside the permanent delta in <code>tools/out-of-tree/delta.txt</code>. The plan is
    "Convergence" in <code>tools/notes/ipu4-out-of-tree-plan.md</code>; the trend is
    the orange line above.
  </p>
  <details>
    <summary>{{ upstream.history.target.files|length }} files to converge</summary>
    <table>
      <thead><tr><th>File</th><th>Status</th><th>Lines</th></tr></thead>
      <tbody>
      {% for f in upstream.history.target.files %}
        <tr><td><code>{{ f.name }}</code></td><td>{{ f.status }}</td><td>{{ f.lines }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </details>
  {% endif %}
  <script id="upstream-history-data" type="application/json">{{ upstream.history | json_dump | safe }}</script>
  {% else %}
  <p class="empty">No history — run <code>tools/upstream/divergence_history.py --fetch --linux &lt;dir&gt;</code>.</p>
  {% endif %}
  <h3>Upstream-watch state</h3>
  <ul class="watch-state">
    {% for branch, ref in upstream.watch.last_seen.items() %}
    <li><code>{{ branch }}</code> {% if ref == "INIT_AT_FIRST_RUN" %}<span class="empty">not set up yet (no watcher run has merged)</span>{% else %}last seen at <code>{{ ref[:12] }}</code>{% endif %}</li>
    {% endfor %}
  </ul>
  <p class="meta">{{ upstream.watch.processed_patch_ids|length }} patch-ids deduped to date</p>
</section>

<details class="card" id="ladder">
  <summary><h2>Test ladder (vm-ipu6)</h2></summary>
  <p class="meta">
    Each leg is a driver under a QEMU model:
    <code>ipu4-out-of-tree</code>, <code>ipu4p</code> and <code>ipu6</code> are the unmodified
    baselines, <code>ipu4-patches</code> is the upstreamable series under all three models.
    <span class="gated">gated</span> tests fail CI unless they pass.
    <a href="{{ ipu6_port.plan_url }}">Plan</a> ·
    {% if ipu6_port.run_url %}<a href="{{ ipu6_port.run_url }}">latest vm-ipu6 run</a>{% else %}<a href="{{ ipu6_port.workflow_url }}">vm-ipu6 runs</a>{% endif %}
  </p>
  {% if not ipu6_port.has_data %}
  <p class="empty">No ladder results yet — the first <code>vm-ipu6</code> run on the default branch populates this.</p>
  {% endif %}
  <div class="kpi-row">
    {% for v in ipu6_port.legs %}
    {% if v.has_data %}
    <div class="kpi ladder-variant {{ 'ladder-ok' if v.summary.ok else 'ladder-bad' }}">
      <div class="kpi-label">{{ v.name }}</div>
      <div class="kpi-value">{{ v.summary.passing }} / {{ v.summary.total }}</div>
      <div class="kpi-sub">tests passing · gated {{ v.summary.enabled_passing }} / {{ v.summary.enabled }} pass</div>
      {% if v.summary.enabled_failing %}<div class="kpi-sub ladder-failing">failing: {{ v.summary.enabled_failing | join(', ') }}</div>{% endif %}
      <div class="kpi-sub">{% if v.run_url %}<a href="{{ v.run_url }}">{% endif %}{{ (v.generated_at or '')[:16] | replace('T', ' ') }}{% if v.run_url %}</a>{% endif %}{% if v.commit_sha %} · <code>{{ v.commit_sha[:7] }}</code>{% endif %}</div>
      {% if v.coverage and v.coverage.lines %}<div class="kpi-sub">driver lines {% if v.coverage_url %}<a href="{{ v.coverage_url }}">{{ v.coverage.lines.pct | pct }}</a>{% else %}{{ v.coverage.lines.pct | pct }}{% endif %} ({{ v.coverage.lines.hit }} / {{ v.coverage.lines.total }})</div>{% endif %}
      {% if v.pin and v.pin.url %}<div class="kpi-sub">base <code>{{ v.pin.tag or (v.pin.url | replace('https://github.com/', '') | replace('.git', '')) ~ '@' ~ (v.pin.sha or '')[:7] }}</code>{% for b in v.base_series %} + {{ b.label }} ({{ b.count }}){% endfor %}{% if v.series_count %} + {{ v.series_count }} IPU4 patch{{ '' if v.series_count == 1 else 'es' }}{% endif %}</div>{% endif %}
    </div>
    {% else %}
    <div class="kpi ladder-variant ladder-none">
      <div class="kpi-label">{{ v.name }}</div>
      <div class="kpi-value">—</div>
      <div class="kpi-sub">not run yet</div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% if ipu6_port.tests %}
  <div class="table-scroll">
  <table class="reg-table ladder-table">
    <thead><tr><th>Test</th>{% for v in ipu6_port.legs %}<th>{{ v.name }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for test in ipu6_port.tests %}
    <tr>
      <td><code>{{ test.name }}</code></td>
      {% for cell in test.cells %}
      {% if cell %}
      <td class="ladder-cell res-{{ cell.css }}">{{ cell.result | lower | replace('-', ' ') }}{% if cell.enabled %} <span class="gated" title="listed in enabled-tests: fails CI unless PASS">gated</span>{% endif %}{% if cell.duration_s %} <span class="dur">{{ cell.duration_s }}s</span>{% endif %}</td>
      {% else %}
      <td class="ladder-cell res-none">{{ 'not run yet' if not ipu6_port.legs[loop.index0].has_data else '—' }}</td>
      {% endif %}
      {% endfor %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  <h3>Driver line coverage per leg</h3>
  <p class="meta">Probe and stream boots of each leg (<code>IPU4_GCOV=1</code>, <code>tools/coverage/ladder.sh</code>). The ipu4p and ipu4-patches trees also count the IPU7/IPU4P code in the driver directory, so compare a driver across variants rather than drivers against each other.</p>
  <canvas id="ladder-coverage-trend" height="80"></canvas>
  {% if ipu6_port.primary %}
  {% set pr = ipu6_port.primary %}
  <h3>Base and series ({{ pr.leg or pr.variant }} run)</h3>
  <ul class="series">
    <li>Mainline <code>{{ pr.pin.url | replace('https://github.com/', '') | replace('.git', '') }}</code>
    {% if pr.pin.tag %}<code>{{ pr.pin.tag }}</code> {% endif %}@ {% if pr.pin.url.startswith('https://github.com/') %}<a href="{{ pr.pin.url | replace('.git', '') }}/commit/{{ pr.pin.sha }}"><code>{{ pr.pin.sha[:12] }}</code></a>{% else %}<code>{{ pr.pin.sha[:12] }}</code>{% endif %}</li>
    {% for b in pr.base_series %}
    <li>+ {{ b.label }}{% if b.source %} ({% if b.url %}<a href="{{ b.url }}">{{ b.source }}</a>{% else %}{{ b.source }}{% endif %}){% endif %}: {{ b.count }} patch{{ '' if b.count == 1 else 'es' }} in <a href="https://github.com/{{ repo }}/tree/main/{{ b.dir }}"><code>{{ b.dir }}/</code></a></li>
    {% endfor %}
    <li>+ IPU4 series: {{ pr.series.count }} patch{{ '' if pr.series.count == 1 else 'es' }} in <a href="https://github.com/{{ repo }}/tree/main/patches/ipu6-ipu4"><code>patches/ipu6-ipu4/</code></a></li>
  </ul>
  {% if pr.series.patches %}
  <ol class="series">
    {% for p in pr.series.patches %}
    <li><a href="https://github.com/{{ repo }}/blob/{{ pr.commit_sha or 'main' }}/patches/ipu6-ipu4/{{ p.file }}">{{ p.subject }}</a></li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="empty">The series is empty (no kernel patches yet).</p>
  {% endif %}
  {% endif %}
</details>

<details class="card" id="harness">
  <summary><h2>Out-of-tree QEMU harness (vm-smoke)</h2></summary>
  <p class="meta">Coverage and silicon-vs-QEMU MMIO divergence of <code>kernel/ipu4/</code> on 6.12, and register handlers of the IPU4 model.</p>
  <section class="sub">
    <h3>Code coverage</h3>
    {% if coverage.summary %}
    <div class="kpi-row">
      <div class="kpi"><div class="kpi-label">lines</div>
        <div class="kpi-value">{{ coverage.summary.lines.pct | pct }}</div>
        <div class="kpi-sub">{{ coverage.summary.lines.hit }} / {{ coverage.summary.lines.total }}</div>
      </div>
      <div class="kpi"><div class="kpi-label">functions</div>
        <div class="kpi-value">{{ coverage.summary.functions.pct | pct }}</div>
        <div class="kpi-sub">{{ coverage.summary.functions.hit }} / {{ coverage.summary.functions.total }}</div>
      </div>
      {% if coverage.summary.branches %}
      <div class="kpi"><div class="kpi-label">branches</div>
        <div class="kpi-value">{{ coverage.summary.branches.pct | pct }}</div>
        <div class="kpi-sub">{{ coverage.summary.branches.hit }} / {{ coverage.summary.branches.total }}</div>
      </div>
      {% endif %}
    </div>
    <p><a href="coverage/index.html">Browse the full lcov report →</a></p>
    {% else %}
    <p class="empty">No coverage data yet — first <code>vm-smoke</code> run that completes <code>STREAM:pattern_ok</code> will populate this.</p>
    {% endif %}
    <canvas id="coverage-trend" height="80"></canvas>
  </section>
  
  <section class="sub">
    <h3>MMIO divergence (silicon vs QEMU)</h3>
    {% if mmio.report %}
    <div class="kpi-row">
      <div class="kpi"><div class="kpi-label">unimplemented</div>
        <div class="kpi-value">{{ mmio.report.unimplemented | length }}</div>
        <div class="kpi-sub">silicon-touched, QEMU silent</div>
      </div>
      <div class="kpi"><div class="kpi-label">value mismatch</div>
        <div class="kpi-value">{{ mmio.report.value_mismatches | length }}</div>
        <div class="kpi-sub">read divergence</div>
      </div>
      <div class="kpi"><div class="kpi-label">extra in QEMU</div>
        <div class="kpi-value">{{ mmio.report.extra_in_qemu | length }}</div>
        <div class="kpi-sub">benign / informational</div>
      </div>
    </div>
    <p>
      silicon: {{ mmio.report.silicon_total }} accesses ·
      qemu: {{ mmio.report.qemu_total }} accesses ·
      <a href="mmio/report.txt">full report.txt →</a>
    </p>
    {% else %}
    <p class="empty">No MMIO trace report yet — first <code>vm-smoke</code> with successful <code>mmiotrace.sh</code> populates this.</p>
    {% endif %}
    <canvas id="mmio-trend" height="80"></canvas>
  </section>
  
  <section class="sub">
    <h3>Register coverage ({{ registers.total }} handlers in <code>hw/misc/ipu4.c</code>)</h3>
    <div class="kpi-row">
      {% for level in ['doc', 'inferred', 'guess'] %}
      <div class="kpi conf-{{ level }}"><div class="kpi-label">{{ level }}</div>
        <div class="kpi-value">{{ registers.counts[level] }}</div>
      </div>
      {% endfor %}
    </div>
    <details>
      <summary>Show register table</summary>
      <table class="reg-table">
        <thead><tr><th>Offset</th><th>Block</th><th>Driver caller</th><th>Confidence</th></tr></thead>
        <tbody>
        {% for r in registers.rows %}
        <tr class="conf-{{ r.confidence }}">
          <td><code>{{ r.offset }}</code></td>
          <td>{{ r.block }}</td>
          <td>{{ r.caller | replace('`','') }}</td>
          <td>{{ r.confidence }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </details>
  </section>
</details>

<footer>
  Generated by <code>tools/dashboard/build.sh</code>. Sources: <code>.github/kernel-pins/</code>, <code>tools/notes/registers.md</code>, <code>tools/notes/upstream-watch-state.json</code>, <code>tools/coverage/summary.json</code>, <code>tools/tests/out/compare-mmio/report.json</code>, <code>tools/tests/out/ipu6-ladder/results.json</code> (vm-ipu6), GitHub Actions API.
</footer>

<script id="history-data" type="application/json">{{ history | json_dump | safe }}</script>
<script>
(function () {
  const upEl = document.getElementById('upstream-history-data');
  const upCanvas = document.getElementById('upstream-trend');
  if (upEl && upCanvas) {
    const up = JSON.parse(upEl.textContent);
    const pts = up.points.map(p => ({ x: p.ts, y: p.divergence, p }));
    const ev = c => c.raw && c.raw.p.event;
    const kindOf = c => (c.raw ? c.raw.p.kind : '');
    const isTag = k => k === 'release' || k === 'rc' || k === 'tag';
    const signed = n => (n > 0 ? '+' : n < 0 ? '\u2212' : '\u00b1') + Math.abs(n);
    const day = ts => new Date(ts).toISOString().slice(0, 10);
    const runs = (JSON.parse(document.getElementById('history-data').textContent) || {}).points || [];
    const targetPts = runs.filter(r => r.target_divergence != null).map(r => ({
      x: Date.parse(r.ts), y: r.target_divergence,
      p: { kind: 'target', ref: 'target tree', ts: Date.parse(r.ts), sha: r.sha || '',
           subject: '', divergence: r.target_divergence } }));
    new Chart(upCanvas, {
      type: 'line',
      data: {
        datasets: [
          { label: 'kernel/ipu4 vs upstream', data: pts, borderColor: '#74a9ff',
            pointRadius: c => (!ev(c) ? 0 : kindOf(c) === 'release' ? 6 : 4),
            pointHitRadius: c => (ev(c) ? 6 : 0),
            pointHoverRadius: c => (ev(c) ? 8 : 0),
            pointStyle: c => (isTag(kindOf(c)) ? 'rectRot' : 'circle'),
            pointBackgroundColor: c => (isTag(kindOf(c)) ? '#d8c46a' : '#74a9ff'),
            stepped: false, tension: 0 },
          ...(targetPts.length ? [{ label: 'vs target tree (per pages run)', data: targetPts,
            borderColor: '#e0a35e', pointRadius: 2, tension: 0 }] : []),
          ...(up.master ? [{ label: 'HEAD vs upstream master', showLine: false,
            data: [{ x: Date.parse(up.master.date), y: up.master.divergence,
                     p: Object.assign({ kind: 'master', ref: 'master', ts: Date.parse(up.master.date),
                                        sha: up.master.sha, subject: '' }, up.master) }],
            pointStyle: 'star', pointRadius: 9, borderColor: '#e08e6e', backgroundColor: '#e08e6e' }] : []),
        ],
      },
      options: {
        responsive: true,
        parsing: false,
        onClick: (e, els) => {
          const p = els.length && els[0].element.$context.raw.p;
          if (!p || p.kind === 'target') return;
          if (isTag(p.kind)) window.open('https://github.com/torvalds/linux/tree/' + p.ref + '/' + up.upstream_path, '_blank');
          else window.open('https://github.com/{{ repo }}/commit/' + p.sha, '_blank');
        },
        plugins: {
          legend: { position: 'bottom' },
          tooltip: { callbacks: {
            title: items => {
              const p = items[0].raw.p;
              if (p.kind === 'target') return 'target tree (' + day(p.ts) + ')';
              if (p.kind === 'master') return 'HEAD vs upstream master ' + p.sha.slice(0, 12) + ' (' + day(p.ts) + ')';
              if (isTag(p.kind)) return 'upstream ' + p.ref + ' (' + day(p.ts) + ')';
              return (p.kind === 'head' ? 'HEAD ' : '') + p.sha.slice(0, 12) + ' (' + day(p.ts) + ')';
            },
            label: item => {
              const p = item.raw.p;
              if (p.kind === 'target') return [p.divergence + ' lines vs the target tree', 'pages run on ' + p.sha.slice(0, 12)];
              const out = [];
              if (p.kind === 'commit') out.push(p.subject);
              if (p.delta != null && p.kind !== 'master') out.push(signed(p.delta) + ' lines \u2192 ' + p.divergence + ' vs ' + p.ref);
              else out.push(p.divergence + ' lines vs ' + p.ref);
              out.push(p.files + ' files, ' + p.lines + ' lines; ' + p.files_missing_upstream + ' not upstream');
              if (p.upstream_only_files) out.push(p.upstream_only_files + ' upstream-only files (' + p.upstream_only_lines + ' lines)');
              if (isTag(p.kind)) out.push('our tree at ' + p.sha.slice(0, 12) + ': ' + p.subject);
              return out;
            },
          } },
        },
        scales: {
          x: { type: 'linear', ticks: { callback: v => day(v), maxTicksLimit: 12 } },
          y: { beginAtZero: true, title: { display: true, text: 'lines' } },
        },
      },
    });
  }

  const raw = document.getElementById('history-data').textContent;
  const history = JSON.parse(raw);
  const points = (history && history.points) || [];
  if (!points.length) return;
  const labels = points.map(p => p.ts.slice(0, 10));

  const lineCfg = (canvasId, datasets) => {
    const el = document.getElementById(canvasId);
    if (!el) return;
    new Chart(el, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: { y: { beginAtZero: false } },
      },
    });
  };

  lineCfg('coverage-trend', [
    { label: 'lines %', data: points.map(p => (p.coverage || {}).lines_pct ?? null), borderColor: '#5ec27e', tension: 0.2 },
    { label: 'functions %', data: points.map(p => (p.coverage || {}).functions_pct ?? null), borderColor: '#74a9ff', tension: 0.2 },
  ]);
  // One colour per QEMU variant; dashed = the variant's baseline driver,
  // solid = ipu4-patches.
  const variantColors = { ipu4: '#5ec27e', ipu4p: '#b48ee0', ipu6: '#74a9ff' };
  const legs = [];
  points.forEach(p => Object.keys(p.ladder_coverage || {}).forEach(l => {
    if (!legs.includes(l)) legs.push(l);
  }));
  legs.sort((a, b) => a.split('/')[1].localeCompare(b.split('/')[1]) ||
    a.startsWith('ipu4-patches/') - b.startsWith('ipu4-patches/'));
  // Every pages run re-reads the newest vm-ipu6 run, so keep one point per
  // vm-ipu6 run (older points without a run id: per change of values), plus
  // the newest, and plot them on a time axis.
  const covKey = p => p.vm_ipu6_run_id || JSON.stringify(p.ladder_coverage);
  const covPts = points.filter(p => Object.keys(p.ladder_coverage || {}).length)
    .filter((p, i, a) => i === 0 || i === a.length - 1 || covKey(p) !== covKey(a[i - 1]));
  const stamp = ts => new Date(ts).toISOString().slice(0, 16).replace('T', ' ');
  const covEl = document.getElementById('ladder-coverage-trend');
  if (covEl && covPts.length) new Chart(covEl, {
    type: 'line',
    data: { datasets: legs.map(l => ({
      label: l,
      data: covPts.filter(p => p.ladder_coverage[l] != null)
        .map(p => ({ x: Date.parse(p.ts), y: p.ladder_coverage[l], sha: p.sha || '' })),
      borderColor: variantColors[l.split('/')[1]] || '#d8c46a',
      backgroundColor: variantColors[l.split('/')[1]] || '#d8c46a',
      borderDash: l.startsWith('ipu4-patches/') ? [] : [5, 4],
      pointRadius: 3,
    })) },
    options: {
      responsive: true,
      parsing: false,
      plugins: {
        legend: { position: 'bottom' },
        tooltip: { callbacks: {
          title: items => stamp(items[0].raw.x) + ' · ' + items[0].raw.sha.slice(0, 7),
          label: item => item.dataset.label + ': ' + item.raw.y.toFixed(1) + '%',
        } },
      },
      scales: {
        x: { type: 'linear', ticks: { callback: v => stamp(v), maxTicksLimit: 8 } },
        y: { title: { display: true, text: 'driver lines %' } },
      },
    },
  });
  lineCfg('mmio-trend', [
    { label: 'unimplemented', data: points.map(p => (p.mmio || {}).unimplemented ?? null), borderColor: '#e08e6e', tension: 0.2 },
    { label: 'value mismatch', data: points.map(p => (p.mmio || {}).value_mismatch ?? null), borderColor: '#d8c46a', tension: 0.2 },
  ]);
})();
</script>
</body>
</html>
