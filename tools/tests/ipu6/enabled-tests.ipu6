# Ladder tests gated in CI for the ipu6 variant of the QEMU model
# (IPU4_VARIANT=ipu6; plan "Parallel track" in
# tools/notes/ipu6-ipu4-plan.md). Same format as enabled-tests (the ipu4
# list): one test name per line, '#' starts a comment. This variant runs
# on unpatched mainline (tools/ipu6/pin.upstream) to develop the model's
# IPU6 emulation against the upstream driver; each parallel-track PR
# enables one more test here.

# Static tests. With no series on this base, series-applies is the bare
# mainline fetch and checkpatch has nothing to check.
series-applies
build
checkpatch

# Guest boot with the model presenting 8086:9a19 (plan "Parallel track", V2).
vm-boot

# virt-sensor + intel-ipu6* load/unload; intel-ipu6 probes 9a19 on load
# (plan "Parallel track", V3).
module-load

# Probe identifies 9a19 as IPU6 (requests intel/ipu/ipu6_fw.bin)
# (plan "Parallel track", V4).
probe-identify
