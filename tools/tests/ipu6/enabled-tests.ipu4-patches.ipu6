# Gate of the ipu4-patches / ipu6 leg: the upstreamable driver under the
# IPU6 QEMU model. Owned by the IPU4 port; gains a test once it passes on
# the IPU6 baseline (enabled-tests.ipu6.ipu6) and here.
#
# One test name per line; '#' starts a comment. Every known test runs on
# every PR, but only the tests listed here fail the job; run
# `tools/tests/ipu6/ladder.sh --list` for the names.

# Static tests: the same tree as ipu4-patches / ipu4.
series-applies
build
checkpatch

# What the IPU6 baseline passes: the series does not break IPU6 probe,
# buttress power-up or the ISYS runtime resume.
vm-boot
module-load
probe-identify
probe-buttress
isys-resume

# PSYS MMU init and the ISYS resume's writes against the upstream driver's
# IPU6 tables, as on the baseline (ipu6 plan V7).
probe-mmu
isys-irq

# Streams under the IPU6 model once the model echoes the capture
# token's buf_handle (IPU6 variant V12).
fw-open
stream-on
stream-pattern
csi2-sof-irq

# Query and format ioctls on the capture node and CSI-2 subdev
# (no hardware access).
v4l2-query

# A PCI function reset drops the firmware authentication; the next probe
# re-runs BOOT_LOAD / AUTH_RUN through the model's CSE.
pci-reauth

# A firmware error on STREAM_START unwinds cleanly (own boot, model
# fail-stream-starts=1).
stream-start-error

# A stream with the virt sensor's CSI-2 frame descriptor (module-load boot).
frame-desc

# Buffers queued while streaming are captured (module-load boot).
stream-requeue

# A probe whose firmware authentication fails unwinds (own boot).
auth-error
