# Gate of the ipu6 / ipu6 leg: the IPU6 baseline, unmodified mainline
# (tools/ipu6/pin.upstream), under the IPU6 QEMU model. Owned by the IPU6
# variant track (tools/notes/ipu6-variant-plan.md); each of its PRs
# enables one more test.
#
# One test name per line; '#' starts a comment. Every known test runs on
# every PR, but only the tests listed here fail the job; run
# `tools/tests/ipu6/ladder.sh --list` for the names.

# Static tests. With no series on this base, series-applies is the bare
# mainline fetch and checkpatch has nothing to check.
series-applies
build
checkpatch

# Guest boot with the model presenting 8086:9a19 (plan "Parallel track", V2).
vm-boot

# virt-sensor + intel-ipu6* load/unload; intel-ipu6 probes 9a19 on load
# (plan "Parallel track", V3).
module-load

# Probe identifies 9a19 as IPU6 (requests intel/ipu/ipu6_fw.bin)
# (plan "Parallel track", V4).
probe-identify

# ISYS/PSYS power-up through IPU6's PWR_STATE layout (ipu6v_pwr_state())
# with the synthesized ipu6_fw.bin (plan "Parallel track", V5).
probe-buttress

# ISYS runtime resume incl. the TSC sync handshake (HH status at
# PWR_STATE bits 12:11 on IPU6) (plan "Parallel track", V6).
isys-resume

# PSYS MMU init at probe and the ISYS resume's MMU/IRQ/LTR writes, checked
# against the upstream driver's IPU6 tables (tools/tests/ipu6/
# upstream_writes.py; no IPU6 silicon trace) (plan "Parallel track", V7).
probe-mmu
isys-irq

# ISYS firmware open: IPU6 SysCom (boot params, DMEM at 0x200000), iwake
# proxy answers and IPU6's response layout in the model; writes checked
# against upstream (plan "Parallel track", V8).
fw-open

# Stream on: MCD PHY power handshake in the model, virt-sensor 2 lanes on
# port 0; CSI-2/PHY writes checked against upstream (plan "Parallel
# track", V9).
stream-on

# The delivered frame carries the model's pattern (plan "Parallel track",
# V10).
stream-pattern

# CSI-2 port 0 error IRQ through the ISR (sync IRQs stay masked upstream)
# (plan "Parallel track", V11).
csi2-sof-irq

# Query and format ioctls on the capture node and CSI-2 subdev
# (no hardware access).
v4l2-query

# A PCI function reset drops the firmware authentication; the next probe
# re-runs BOOT_LOAD / AUTH_RUN through the model's CSE.
pci-reauth

# A firmware error on STREAM_START unwinds cleanly (own boot, model
# fail-stream-starts=1).
stream-start-error

# A stream with the virt sensor's CSI-2 frame descriptor (module-load boot).
frame-desc

# Buffers queued while streaming are captured (module-load boot).
stream-requeue
