# shellcheck shell=bash
# Pinned base tree for the ipu6 flavor (IPU4_FLAVOR=ipu6): a mainline tag.
# Sourced by tools/ipu6/*.sh. patches/ipu6-ipu7/, patches/ipu6-ipu4p/
# and patches/ipu6-ipu4/ are applied on top. Bumped weekly to the
# newest mainline tag by tools/ipu6/bump-pin.sh.
#
# The GitHub mirror, as kernel.org is not reachable from CI. SHA is the
# tag's commit.
IPU6_LINUX_URL="${IPU4_IPU6_LINUX_URL:-https://github.com/torvalds/linux.git}"
IPU6_LINUX_TAG="v7.3-rc4"
IPU6_LINUX_SHA="${IPU4_IPU6_LINUX_SHA:-93f51579e7df248780214094418f205253383cc5}"
