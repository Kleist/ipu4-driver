# shellcheck shell=bash
# Pinned base tree for the ipu6 flavor (IPU4_FLAVOR=ipu6). Sourced by
# tools/ipu6/*.sh. A pin bump is a one-line change to IPU6_LINUX_SHA here
# (plus the "Base" table in tools/notes/ipu6-ipu4-plan.md).
#
# Ruslan Bay's IPU4P series on v7.3-rc4, branch ipu4p-upstream, commit
# "media: ipu6: Enable IPU4P PCI device". The repository's default branch
# is unrelated, so bootstrap fetches this SHA directly.
IPU6_LINUX_URL="${IPU4_IPU6_LINUX_URL:-https://github.com/ruslanbay/linux.git}"
IPU6_LINUX_SHA="${IPU4_IPU6_LINUX_SHA:-340985596f38c6a4cb93a451ce5e6ec436b805e4}"
