From 8f229de26d2108d8e294eaa4ef31d5c4e456dfd1 Mon Sep 17 00:00:00 2001
From: Andreas Helbech Kleist <andreaskleist@gmail.com>
Date: Sun, 11 Oct 2026 00:16:45 +0000
Subject: [PATCH] media: ipu6: Add the IPU4 ISYS stream limits

IPU4 is left with the IPU6 ISYS stream and firmware queue limits, so
the driver opens the ISYS firmware with twelve message send queues, one
per parallel stream, and a sixteen-entry device send queue. The IPU4
ISYS firmware handles eight streams, like IPU4P's: the IPU4 reference
driver configures eight message send queues and an eight-entry device
send queue, and on the hardware the firmware's message receive queue
pointers follow exactly eight message send queues in the SysCom
registers.

Use the IPU4P stream and queue limits for IPU4.

Signed-off-by: Andreas Helbech Kleist <andreaskleist@gmail.com>
---
 drivers/media/pci/intel/ipu6/ipu6.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/media/pci/intel/ipu6/ipu6.c b/drivers/media/pci/intel/ipu6/ipu6.c
index 2dfd6646f..01aa420de 100644
--- a/drivers/media/pci/intel/ipu6/ipu6.c
+++ b/drivers/media/pci/intel/ipu6/ipu6.c
@@ -471,6 +471,11 @@ static void ipu6_internal_pdata_init(struct ipu6_device *isp)
 
 	if (IS_IPU4(isp)) {
 		isys_ipdata.csi2.nports = IPU4_ISYS_CSI2_NPORTS;
+		/* IPU4 has the IPU4P firmware stream limits */
+		isys_ipdata.num_parallel_streams = IPU4P_ISYS_MAX_STREAMS;
+		isys_ipdata.max_streams = IPU4P_ISYS_MAX_STREAMS;
+		isys_ipdata.max_sram_blocks = IPU4P_NOF_SRAM_BLOCKS_MAX;
+		isys_ipdata.max_devq_size = IPU4P_DEV_SEND_QUEUE_SIZE;
 		/* IPU4 has the IPU4P subsystem layout */
 		isys_ipdata.hw_variant.offset = IPU4P_ISYS_OFFSET;
 		isys_ipdata.hw_variant.spc_offset = IPU4P_ISYS_SPC_OFFSET;
