From 2c5eaf6e5ae354aac1738b5dfe29fec92575a76c Mon Sep 17 00:00:00 2001
From: Andreas Helbech Kleist <andreaskleist@gmail.com>
Date: Sun, 11 Oct 2026 05:22:24 +0000
Subject: [PATCH 09/10] media: ipu6: Add IPU4 CSI-2 receiver support

IPU4 took the IPU6 path when a CSI-2 port is enabled for streaming:
it programs the IPU6 CSI-2 front end and port hub registers and then
powers up the IPU6 MCD PHY, none of which IPU4 has, so the stream
start fails with "PHY0 powerup ack timeout".

IPU4 has no PHY for the driver to set up. Its CSI-2 receiver has the
IPU4P register layout at the port base: the clock and data lane
termination and settle counts for up to four data lanes, the receiver
configuration (release from LP-11, no byte clock gating), the number
of lanes and the enable. The receiver errors are reported by the
port's CSIRX interrupt controller, which is enabled at stream start.

Add the IPU4 CSI-2 receiver enable and disable, and don't set up a PHY
power hook for IPU4. Reject lane counts the receiver has no timing
registers for. At stream stop, hold off the CSIRX interrupt
and wait for a running ISR, report the receiver errors before the
receiver is disabled, and mask the CSIRX interrupts again.

Signed-off-by: Andreas Helbech Kleist <andreaskleist@gmail.com>
---
 drivers/media/pci/intel/ipu6/ipu6-isys-csi2.c | 76 +++++++++++++++++++
 drivers/media/pci/intel/ipu6/ipu6-isys.c      |  2 +-
 2 files changed, 77 insertions(+), 1 deletion(-)

diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys-csi2.c b/drivers/media/pci/intel/ipu6/ipu6-isys-csi2.c
index 85354905f..756b26043 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys-csi2.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys-csi2.c
@@ -10,6 +10,7 @@
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/err.h>
+#include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/minmax.h>
 #include <linux/pm_runtime.h>
@@ -426,6 +427,73 @@ static void ipu6_isys_csi2_clear_watermark(struct ipu6_isys_csi2 *csi2)
 	ipu6_isys_update_watermark_setting(csi2->isys);
 }
 
+/*
+ * IPU4 has no PHY registers for the driver to set up: the receiver timing
+ * and the lane count go to the CSI-2 receiver, which has the IPU4P register
+ * layout, and the receiver errors are reported by the port's CSIRX
+ * interrupt controller.
+ */
+static int ipu4_isys_csi2_stream_enable(struct ipu6_isys_csi2 *csi2,
+					const struct ipu6_isys_csi2_timing *timing)
+{
+	struct device *dev = &csi2->isys->adev->auxdev.dev;
+	void __iomem *base = csi2->base;
+	u32 mask = IPU4_CSI2_CSIRX_ERROR_IRQ_MASK;
+	u32 val;
+
+	if (!csi2->nlanes || csi2->nlanes > IPU4_CSI2_RX_MAX_DLANES) {
+		dev_err(dev, "csi2-%u: unsupported number of lanes %u\n",
+			csi2->port, csi2->nlanes);
+		return -EINVAL;
+	}
+
+	writel(timing->ctermen, base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_CLANE);
+	writel(timing->csettle, base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_CLANE);
+	for (unsigned int lane = 0; lane < csi2->nlanes; lane++) {
+		writel(timing->dtermen,
+		       base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(lane));
+		writel(timing->dsettle,
+		       base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(lane));
+	}
+
+	val = readl(base + IPU4P_CSI2_RX_CONFIG);
+	val |= IPU4P_CSI2_RX_CONFIG_DISABLE_BYTE_CLK_GATING |
+	       IPU4P_CSI2_RX_CONFIG_RELEASE_LP11;
+	writel(val, base + IPU4P_CSI2_RX_CONFIG);
+	writel(csi2->nlanes, base + IPU4P_CSI2_RX_NOF_ENABLED_LANES);
+	writel(IPU4P_CSI2_RX_ENABLE_ENABLE, base + IPU4P_CSI2_RX_ENABLE);
+
+	writel(mask, base + IPU4_CSI2_CSIRX_IRQ_EDGE);
+	writel(0, base + IPU4_CSI2_CSIRX_IRQ_LEVEL_NOT_PULSE);
+	writel(mask, base + IPU4_CSI2_CSIRX_IRQ_CLEAR);
+	writel(mask, base + IPU4_CSI2_CSIRX_IRQ_MASK);
+	writel(mask, base + IPU4_CSI2_CSIRX_IRQ_ENABLE);
+
+	return 0;
+}
+
+static void ipu4_isys_csi2_stream_disable(struct ipu6_isys_csi2 *csi2)
+{
+	void __iomem *base = csi2->base;
+	u32 val;
+
+	/*
+	 * Report what the receiver saw before it is switched off, with the
+	 * CSIRX interrupt held off so the ISR does not collect them too.
+	 */
+	writel(0, base + IPU4_CSI2_CSIRX_IRQ_ENABLE);
+	synchronize_irq(csi2->isys->adev->isp->pdev->irq);
+	ipu6_isys_csi2_error(csi2);
+
+	val = readl(base + IPU4P_CSI2_RX_CONFIG);
+	val &= ~(IPU4P_CSI2_RX_CONFIG_DISABLE_BYTE_CLK_GATING |
+		 IPU4P_CSI2_RX_CONFIG_RELEASE_LP11);
+	writel(val, base + IPU4P_CSI2_RX_CONFIG);
+	writel(0, base + IPU4P_CSI2_RX_ENABLE);
+
+	writel(0, base + IPU4_CSI2_CSIRX_IRQ_MASK);
+}
+
 static void ipu6_isys_csi2_stream_disable(struct ipu6_isys_csi2 *csi2)
 {
 	struct ipu6_isys *isys = csi2->isys;
@@ -435,6 +503,11 @@ static void ipu6_isys_csi2_stream_disable(struct ipu6_isys_csi2 *csi2)
 	cfg.port = csi2->port;
 	cfg.nlanes = csi2->nlanes;
 
+	if (IS_IPU4(isys->adev->isp)) {
+		ipu4_isys_csi2_stream_disable(csi2);
+		return;
+	}
+
 	if (IS_IPU4P(csi2->isys->adev->isp)) {
 		isys->phy_set_power(isys, &cfg, NULL, false);
 		return;
@@ -474,6 +547,9 @@ static int ipu6_isys_csi2_stream_enable(struct ipu6_isys_csi2 *csi2)
 	if (ret)
 		return ret;
 
+	if (IS_IPU4(isys->adev->isp))
+		return ipu4_isys_csi2_stream_enable(csi2, &timing);
+
 	if (IS_IPU4P(isys->adev->isp))
 		return isys->phy_set_power(isys, &cfg, &timing, true);
 
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.c b/drivers/media/pci/intel/ipu6/ipu6-isys.c
index d73f570a0..380e2fad8 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.c
@@ -1179,7 +1179,7 @@ static int isys_probe(struct auxiliary_device *auxdev,
 		isys->phy_set_power = ipu6_isys_dwc_phy_set_power;
 	else if (IS_IPU4P(adev->isp))
 		isys->phy_set_power = ipu4p_isys_phy_set_power;
-	else
+	else if (!IS_IPU4(adev->isp))	/* IPU4 has no PHY to set up */
 		isys->phy_set_power = ipu6_isys_mcd_phy_set_power;
 
 	ret = isys_register_devices(isys);
-- 
