From 4831bc82ff8f0603f4e0ecc5dadaadc2970f0649 Mon Sep 17 00:00:00 2001
From: Andreas Helbech Kleist <andreaskleist@gmail.com>
Date: Sat, 10 Oct 2026 20:42:34 +0000
Subject: [PATCH 05/10] media: ipu6: Add IPU4 ISYS and CSI-2 register
 definitions

IPU4 has six CSI-2 ports. Their interrupts are summarised in the ISYS
UNISPART interrupt controller, which is at the same offsets as on IPU4P
but uses different bits: ports 0-3 on bits 3-6, ports 4 and 5 on bits
11 and 12, and the firmware software interrupt on bit 30. Each port has
interrupt controllers of its own: CSI2PART at 0x400 from the port base
summarises the port's interrupts, CSIRX at 0x500 reports the 17
receiver errors. The receiver registers have the IPU4P layout, with
timing registers for four data lanes.

Define the registers used by the ISYS driver next to the IPU4P ones,
including the UNISPART mask, enable and level registers, which the
IPU4P driver does not use.

Signed-off-by: Andreas Helbech Kleist <andreaskleist@gmail.com>
---
 .../pci/intel/ipu6/ipu4p-isys-csi2-regs.h     | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h
index 4b7510e05..97dd748e8 100644
--- a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h
+++ b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h
@@ -69,4 +69,39 @@ static inline u32 ipu4p_isys_csi_irq_ctrl0_base(unsigned int port)
 /* CSI receiver general-purpose registers */
 #define IPU4P_CSI2_GPREG_CR_PORT_CONFIG			0x14
 
+/*
+ * IPU4. The ISYS UNISPART interrupt registers are at the IPU4P offsets
+ * above but use different bits: CSI-2 ports 0-3 interrupt on bits 3-6,
+ * ports 4 and 5 on bits 11 and 12. The CSI-2 receiver registers have
+ * the IPU4P_CSI2_RX_* layout, with timing registers for four data lanes.
+ */
+#define IPU4P_ISYS_UNISPART_IRQ_MASK			0x7c004
+#define IPU4P_ISYS_UNISPART_IRQ_ENABLE			0x7c010
+#define IPU4P_ISYS_UNISPART_IRQ_LEVEL_NOT_PULSE		0x7c014
+#define IPU4_ISYS_CSI2_NPORTS				6U
+#define IPU4_CSI2_RX_MAX_DLANES				4U
+#define IPU4_ISYS_UNISPART_IRQ_SW			BIT(30)
+
+static inline u32 ipu4_isys_unispart_irq_csi2(unsigned int port)
+{
+	return port < 4 ? BIT(3 + port) : BIT(11 + port - 4);
+}
+
+/*
+ * IPU4 per-port interrupt controllers, at offsets from the CSI-2 port
+ * base. CSI2PART summarises the port's interrupts, CSIRX reports the
+ * receiver errors.
+ */
+#define IPU4_CSI2_CSI2PART_IRQ_STATUS			0x408
+#define IPU4_CSI2_CSI2PART_IRQ_CLEAR			0x40c
+#define IPU4_CSI2_CSI2PART_IRQ_CSIRX			BIT(16)
+
+#define IPU4_CSI2_CSIRX_IRQ_EDGE			0x500
+#define IPU4_CSI2_CSIRX_IRQ_MASK			0x504
+#define IPU4_CSI2_CSIRX_IRQ_STATUS			0x508
+#define IPU4_CSI2_CSIRX_IRQ_CLEAR			0x50c
+#define IPU4_CSI2_CSIRX_IRQ_ENABLE			0x510
+#define IPU4_CSI2_CSIRX_IRQ_LEVEL_NOT_PULSE		0x514
+#define IPU4_CSI2_CSIRX_ERROR_IRQ_MASK			GENMASK(16, 0)
+
 #endif /* IPU4P_ISYS_CSI2_REGS_H */
