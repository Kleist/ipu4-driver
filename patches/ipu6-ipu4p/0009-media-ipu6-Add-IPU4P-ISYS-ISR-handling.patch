@@ -9,6 +9,7 @@
 #include <linux/types.h>
 
 #define IPU4P_ISYS_MAX_STREAMS			8U
+#define IPU4P_ISYS_CSI2_NPORTS			8U
 #define IPU4P_MAX_IPINS				4U
